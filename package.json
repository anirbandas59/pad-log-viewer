{
  "name": "pad-log-viewer",
  "private": true,
  "version": "1.0.1",
  "description": "Single-file HTML viewer for Power Automate Desktop run-log CSVs",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && node scripts/check-size.mjs",
    "sanitize": "node scripts/sanitize-log.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.17",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.4"
  }
}
